@@ -17 +17 @@ use crate::state::RawLua;
-use crate::util::{StackGuard, assert_stack, linenumber_to_usize, ptr_to_lossy_str, ptr_to_str};
+use crate::util::{StackGuard, assert_stack, check_stack, linenumber_to_usize, ptr_to_lossy_str, ptr_to_str};
@@ -63,0 +64,34 @@ impl<'a> Debug<'a> {
+    /// Returns the positive-indexed local at this active stack frame.
+    ///
+    /// Trial extension for Lua 5.4 only. Names are copied; returned values use
+    /// mlua's existing GC-rooted representation. Varargs are intentionally excluded.
+    #[cfg(feature = "lua54")]
+    pub fn local(&self, index: u32) -> crate::Result<Option<(String, crate::Value)>> {
+        let index = c_int::try_from(index)
+            .ok()
+            .filter(|index| *index > 0)
+            .ok_or_else(|| crate::Error::runtime("local index must be in 1..=c_int::MAX"))?;
+        // SAFETY: Debug is borrowed from a synchronous hook/inspect_stack callback.
+        // callback_error_ext's StateGuard selects this active state (including
+        // coroutines); no user code runs between getlocal and rooting its value.
+        // The guard restores the original top on every Result path. getlocal
+        // pushes exactly one value on success; try_pop_value roots then pops it,
+        // including its auxiliary-stack failure path. Reserve its extra slot.
+        unsafe {
+            if self.lua.state() != self.state {
+                return Err(crate::Error::runtime(
+                    "debug frame is not on the active Lua state",
+                ));
+            }
+            let _sg = StackGuard::new(self.state);
+            check_stack(self.state, 2)?;
+            let name = ffi::lua_getlocal(self.state, self.ar, index);
+            if name.is_null() {
+                return Ok(None);
+            }
+            let name = std::ffi::CStr::from_ptr(name).to_string_lossy().into_owned();
+            let value = self.lua.try_pop_value()?;
+            Ok(Some((name, value)))
+        }
+    }
+
