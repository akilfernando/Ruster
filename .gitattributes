# Preserve upstream license payloads verbatim, including their original line endings.
THIRD_PARTY_NOTICES.txt -text -whitespace
# One unmodified upstream source file uses CRLF; keep its bytes and other whitespace checks.
third_party/wgpu-hal/src/vulkan/descriptor.rs -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Supplemental upstream license hashes require byte-for-byte preservation.
packaging/licenses/*.txt -text

# Raw AA captures retain the tool's terminating blank line verbatim.
docs/evidence/m8-aa-*.txt whitespace=-blank-at-eof
